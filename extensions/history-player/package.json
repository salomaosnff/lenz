{
  "name": "history-player",
  "displayName": "Reprodutor de histórico",
  "version": "0.0.0",
  "private": true,
  "description": "Grava as alterações dos arquivos e as reproduz como um vídeo; guarda, baixa e carrega gravações.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vp build",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lenz-sdk": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "contributes": {
    "commands": [
      {
        "command": "history-player.start",
        "title": "Iniciar a gravação",
        "category": "Histórico",
        "icon": "lucide:circle-dot",
        "when": "!history-player.recording"
      },
      {
        "command": "history-player.stop",
        "title": "Parar a gravação",
        "category": "Histórico",
        "icon": "lucide:square",
        "when": "history-player.recording"
      },
      {
        "command": "history-player.open",
        "title": "Abrir o reprodutor de histórico",
        "category": "Histórico",
        "icon": "lucide:clapperboard"
      },
      {
        "command": "history-player.toggle",
        "title": "Reproduzir ou pausar a gravação",
        "category": "Histórico",
        "icon": "lucide:play"
      },
      {
        "command": "history-player.load",
        "title": "Carregar uma gravação de um arquivo",
        "category": "Histórico",
        "icon": "lucide:upload"
      }
    ],
    "keybindings": [
      {
        "key": "Mod+Alt+R",
        "command": "history-player.start",
        "when": "!history-player.recording"
      },
      {
        "key": "Mod+Alt+R",
        "command": "history-player.stop",
        "when": "history-player.recording"
      },
      {
        "key": "Mod+Alt+H",
        "command": "history-player.open"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "history-player",
          "title": "Gravações",
          "icon": "lucide:clapperboard"
        }
      ]
    },
    "views": {
      "history-player": [
        {
          "id": "history-player.recordings",
          "name": "Gravações"
        }
      ]
    },
    "tools": [
      {
        "name": "start_recording",
        "description": "Starts recording the history of the files: the files that are open now, and every edit from here on, so it can be played back later. Does nothing if a recording is already going.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "stop_recording",
        "description": "Stops the recording in progress and saves it, without asking the user anything. It already has a name (the date); pass name to give it another. Unlike the command history-player.stop, which opens dialogs.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name to save it with. Defaults to the one it has (the date and time)."
            }
          }
        }
      },
      {
        "name": "list_recordings",
        "description": "Lists the saved recordings, newest first, and the one in progress, if any.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "readOnly": true
      },
      {
        "name": "rename_recording",
        "description": "Gives a saved recording another name.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The id of a recording, from list_recordings."
            },
            "name": {
              "type": "string",
              "description": "The new name."
            }
          },
          "required": [
            "id",
            "name"
          ]
        }
      },
      {
        "name": "delete_recording",
        "description": "Deletes a saved recording, without asking: it cannot be undone. One in progress is refused: stop it first.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The id of a recording, from list_recordings."
            }
          },
          "required": [
            "id"
          ]
        },
        "consequential": true
      }
    ]
  }
}
