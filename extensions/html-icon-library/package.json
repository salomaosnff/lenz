{
  "name": "html-icon-library",
  "displayName": "Biblioteca de ícones",
  "version": "0.0.0",
  "private": true,
  "description": "Biblioteca de ícones SVG para o editor visual de HTML: busque entre mais de 2.000 ícones, ajuste tamanho, cor e traço, e insira na página ou copie o SVG.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vp build",
    "test": "vp test run",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "html-visual-editor": "workspace:*",
    "lenz-sdk": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "contributes": {
    "commands": [
      {
        "command": "html-icon-library.open",
        "title": "Abrir a biblioteca de ícones",
        "category": "Editor visual",
        "icon": "lucide:shapes",
        "when": "activeEditor == 'html-visual-editor.visual'"
      }
    ]
  },
  "extensionDependencies": [
    "html-visual-editor"
  ]
}
