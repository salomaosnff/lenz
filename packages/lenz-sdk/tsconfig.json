{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "globals.d.ts"]
}
